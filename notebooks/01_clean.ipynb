# ===== 01 数据清洗 =====
# 清洗 orders、items、customers、payments、reviews、products 六张表

import pandas as pd
import os

output_dir = r'C:\Users\15442\OneDrive\Desktop\Olist\data\clean'
os.makedirs(output_dir, exist_ok=True)
# ===== Cell 1：清洗 orders =====
orders = pd.read_csv(r'C:\Users\15442\OneDrive\Desktop\Olist\data\raw\olist_orders_dataset.csv')

# 时间字段转datetime
date_cols = [
    'order_purchase_timestamp',
    'order_approved_at',
    'order_delivered_carrier_date',
    'order_delivered_customer_date',
    'order_estimated_delivery_date'
]
for col in date_cols:
    orders[col] = pd.to_datetime(orders[col])

# 查看订单状态分布
print("订单状态分布：")
print(orders['order_status'].value_counts())

# 只保留已交付订单
orders_delivered = orders[orders['order_status'] == 'delivered'].copy()
print(f'\n原始订单: {len(orders)}, 已交付: {len(orders_delivered)}')

# 计算配送天数
orders_delivered['delivery_days'] = (
    orders_delivered['order_delivered_customer_date'] -
    orders_delivered['order_purchase_timestamp']
).dt.days

# 计算预计配送天数
orders_delivered['estimated_days'] = (
    orders_delivered['order_estimated_delivery_date'] -
    orders_delivered['order_purchase_timestamp']
).dt.days

# 条件：delivery_days <0 或者 delivery_days >200
abnormal_mask = (orders_delivered['delivery_days'] < 0) | (orders_delivered['delivery_days'] > 200)
Abnormal_order = orders_delivered[abnormal_mask].copy()
print(f"异常订单数量：{len(Abnormal_order)}")

# 保存异常订单文件
Abnormal_order.to_csv(os.path.join(output_dir, "Abnormal_order.csv"), index=False)

# 迟到标记
orders_delivered['is_late'] = (
    orders_delivered['order_delivered_customer_date'] >
    orders_delivered['order_estimated_delivery_date']
).astype(int)

# 检查异常值
print("\ndelivery_days 描述统计：")
print(orders_delivered['delivery_days'].describe())

# 过滤异常值
orders_delivered = orders_delivered[
    (orders_delivered['delivery_days'] >= 0) &
    (orders_delivered['delivery_days'] <= 200)
]

output_file = os.path.join(output_dir, "orders_clean.csv")
orders_delivered.to_csv(output_file, index=False)

print(f'\n清洗后订单: {len(orders_delivered)}')
print(f'✅ 文件已保存到：{output_file}')
# ===== Cell 2：清洗 items =====
items = pd.read_csv(r'C:\Users\15442\OneDrive\Desktop\Olist\data\raw\olist_order_items_dataset.csv')

# 订单金额 = 商品价 + 运费
items['order_value'] = items['price'] + items['freight_value']

# 检查空值
print("空值统计：")
print(items.isnull().sum())

# 检查异常值
print("\n价格/运费/订单金额描述统计：")
print(items[['price', 'freight_value', 'order_value']].describe())

output_file = os.path.join(output_dir, 'items_clean.csv')
items.to_csv(output_file, index=False)
print(f'\n✅ 已保存：{output_file}')
# ===== Cell 3：清洗 customers =====
customers = pd.read_csv(r'C:\Users\15442\OneDrive\Desktop\Olist\data\raw\olist_customers_dataset.csv')

# 查看两种客户ID的唯一数量
print(f"customer_id唯一数: {customers['customer_id'].nunique()}")
print(f"customer_unique_id唯一数: {customers['customer_unique_id'].nunique()}")

# 简单校验空值
print("\n空值统计：")
print(customers.isnull().sum())

# 保存清洗文件
output_file = os.path.join(output_dir, 'customers_clean.csv')
customers.to_csv(output_file, index=False)
print(f"\n✅ customers_clean.csv 已保存至：{output_file}")
# ===== Cell 4：清洗 payments =====
payments = pd.read_csv(r'C:\Users\15442\OneDrive\Desktop\Olist\data\raw\olist_order_payments_dataset.csv')

# 空值检查
print("支付表空值统计：")
print(payments.isnull().sum())

# 按订单聚合
payments_agg = payments.groupby('order_id').agg(
    payment_value=('payment_value', 'sum'),
    payment_type=('payment_type', lambda x: x.mode()[0]),
    payment_installments=('payment_installments', 'max')
).reset_index()

print(f"\n原始支付明细行数：{len(payments)}")
print(f"聚合后订单行数：{len(payments_agg)}")
print("\n聚合后前5行：")
print(payments_agg.head())

# 保存
output_file = os.path.join(output_dir, 'payments_clean.csv')
payments_agg.to_csv(output_file, index=False)
print(f"\n✅ payments_clean.csv 已保存至：{output_file}")
# ===== Cell 5：清洗 reviews =====
reviews = pd.read_csv(r'C:\Users\15442\OneDrive\Desktop\Olist\data\raw\olist_order_reviews_dataset.csv')

print("原始评价表行数：", len(reviews))
print("\n空值统计：")
print(reviews.isnull().sum())

# 按order_id去重，一个订单保留第一条评价
reviews = reviews.drop_duplicates(subset='order_id', keep='first')
print(f"\n去重后行数：{len(reviews)}")

# 差评标记：评分<=2标记为1
reviews['is_bad_review'] = (reviews['review_score'] <= 2).astype(int)
print("\n差评分布：")
print(reviews['is_bad_review'].value_counts())

# 保存
output_file = os.path.join(output_dir, 'reviews_clean.csv')
reviews.to_csv(output_file, index=False)
print(f"\n✅ reviews_clean.csv 已保存至：{output_file}")
# ===== Cell 6：清洗 products =====
products = pd.read_csv(r'C:\Users\15442\OneDrive\Desktop\Olist\data\raw\olist_products_dataset.csv')
translation = pd.read_csv(r'C:\Users\15442\OneDrive\Desktop\Olist\data\raw\product_category_name_translation.csv')

print("产品表原始行数：", len(products))
print("\n产品表空值统计：")
print(products.isnull().sum())

# 葡语品类缺失填充unknown
products['product_category_name'] = products['product_category_name'].fillna('unknown')

# 左连接翻译表，增加英文品类
products = products.merge(translation, on='product_category_name', how='left')

# 英文品类兜底填充
products['product_category_name_english'] = products['product_category_name_english'].fillna('unknown')

print("\n合并后产品表行数：", len(products))
print("\n品类分布（英文）：")
print(products['product_category_name_english'].value_counts().head(10))

# 保存文件
output_file = os.path.join(output_dir, 'products_clean.csv')
products.to_csv(output_file, index=False)
print(f"\n✅ products_clean.csv 已保存至：{output_file}")