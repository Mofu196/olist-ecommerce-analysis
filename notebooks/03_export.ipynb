# ===== 03 导出所有分析结果 + RFM 汇总 =====

import pandas as pd
import os
from sqlalchemy import create_engine

engine = create_engine('mysql+pymysql://root:root@localhost:3306/olist?charset=utf8mb4')

output_dir = r'C:\Users\15442\OneDrive\Desktop\Olist\data\clean\exported'
os.makedirs(output_dir, exist_ok=True)
# ===== Cell 1：导出所有分析结果 =====
queries = {
    # 运营指标
    'monthly_gmv': """
        WITH order_level AS (
          SELECT order_id, DATE_FORMAT(MAX(order_purchase_timestamp), '%%Y-%%m') AS order_month,
                 SUM(price) + MAX(freight_value) AS order_gmv
          FROM olist_clean GROUP BY order_id
        )
        SELECT order_month, COUNT(*) AS orders, ROUND(SUM(order_gmv), 2) AS gmv, ROUND(AVG(order_gmv), 2) AS aov
        FROM order_level WHERE order_month >= '2017-01' GROUP BY order_month ORDER BY order_month;
    """,
    # 客户行为
    'dau': """
        SELECT order_date, COUNT(DISTINCT customer_unique_id) AS dau, COUNT(DISTINCT order_id) AS orders
        FROM olist_clean WHERE order_date >= '2017-01-01' GROUP BY order_date ORDER BY order_date;
    """,
    'mau': """
        SELECT order_month, COUNT(DISTINCT customer_unique_id) AS mau, COUNT(DISTINCT order_id) AS orders
        FROM olist_clean WHERE order_month >= '2017-01' GROUP BY order_month ORDER BY order_month;
    """,
    'new_old_customers': """
        SELECT order_month, COUNT(DISTINCT customer_unique_id) AS total_customers,
               COUNT(DISTINCT CASE WHEN is_new_customer = 1 THEN customer_unique_id END) AS new_customers,
               COUNT(DISTINCT customer_unique_id) - COUNT(DISTINCT CASE WHEN is_new_customer = 1 THEN customer_unique_id END) AS old_customers,
               ROUND(COUNT(DISTINCT CASE WHEN is_new_customer = 1 THEN customer_unique_id END) * 100.0 / COUNT(DISTINCT customer_unique_id), 2) AS new_rate
        FROM olist_clean WHERE order_month >= '2017-01' GROUP BY order_month ORDER BY order_month;
    """,
    'payment_type': """
        SELECT payment_type, COUNT(DISTINCT order_id) AS orders,
               ROUND(COUNT(DISTINCT order_id) * 100.0 / SUM(COUNT(DISTINCT order_id)) OVER(), 2) AS pct,
               ROUND(AVG(payment_value), 2) AS avg_payment
        FROM olist_clean WHERE payment_value IS NOT NULL GROUP BY payment_type ORDER BY orders DESC;
    """,
    # 商品指标
    'category_gmv': """
        SELECT product_category_name_english AS category, ROUND(SUM(order_value), 2) AS detail_gmv,
               COUNT(DISTINCT order_id) AS orders, ROUND(AVG(review_score), 2) AS avg_rating
        FROM olist_clean WHERE product_category_name_english != 'unknown'
        GROUP BY category ORDER BY detail_gmv DESC LIMIT 10;
    """,
    'category_bad_review': """
        SELECT product_category_name_english AS category, COUNT(DISTINCT order_id) AS orders,
               ROUND(SUM(order_value), 2) AS gmv, ROUND(AVG(review_score), 2) AS avg_rating,
               ROUND(SUM(is_bad_review) * 100.0 / COUNT(*), 2) AS bad_review_rate
        FROM olist_clean WHERE review_score IS NOT NULL AND product_category_name_english != 'unknown'
        GROUP BY category HAVING COUNT(*) >= 100 ORDER BY gmv DESC;
    """,
    # 配送归因
    'state_late_rate': """
        SELECT customer_state, COUNT(DISTINCT order_id) AS orders,
               ROUND(AVG(delivery_days), 1) AS avg_delivery_days,
               ROUND(SUM(is_late) * 100.0 / COUNT(*), 2) AS late_rate,
               ROUND(AVG(review_score), 2) AS avg_rating
        FROM olist_clean GROUP BY customer_state HAVING COUNT(DISTINCT order_id) >= 100
        ORDER BY late_rate DESC LIMIT 15;
    """,
    'delivery_bucket': """
        SELECT CASE
                 WHEN delivery_days <= 7 THEN '1周内'
                 WHEN delivery_days <= 14 THEN '1-2周'
                 WHEN delivery_days <= 21 THEN '2-3周'
                 WHEN delivery_days <= 30 THEN '3-4周'
                 ELSE '4周以上'
               END AS delivery_bucket,
               COUNT(DISTINCT order_id) AS orders,
               ROUND(AVG(review_score), 2) AS avg_rating,
               ROUND(SUM(is_bad_review) * 100.0 / COUNT(*), 2) AS bad_review_rate
        FROM olist_clean WHERE review_score IS NOT NULL
        GROUP BY delivery_bucket ORDER BY MIN(delivery_days);
    """,
    'late_vs_ontime': """
        SELECT CASE WHEN is_late = 1 THEN '迟到' ELSE '准时' END AS delivery_status,
               COUNT(DISTINCT order_id) AS orders,
               ROUND(AVG(review_score), 2) AS avg_rating,
               ROUND(SUM(is_bad_review) * 100.0 / COUNT(*), 2) AS bad_review_rate
        FROM olist_clean WHERE review_score IS NOT NULL GROUP BY delivery_status;
    """,
    # RFM分层
    'rfm_segment': """
        WITH rfm_base AS (
          SELECT customer_unique_id,
                 DATEDIFF('2018-10-01', MAX(DATE(order_purchase_timestamp))) AS recency,
                 COUNT(DISTINCT order_id) AS frequency,
                 ROUND(SUM(order_value), 2) AS monetary
          FROM olist_clean GROUP BY customer_unique_id
        ),
        rfm_score AS (
          SELECT *,
                 NTILE(5) OVER (ORDER BY recency DESC) AS r_score,
                 NTILE(5) OVER (ORDER BY frequency ASC) AS f_score,
                 NTILE(5) OVER (ORDER BY monetary ASC) AS m_score
          FROM rfm_base
        )
        SELECT customer_unique_id, recency, frequency, monetary, r_score, f_score, m_score,
               CASE
                 WHEN r_score >= 4 AND f_score >= 4 AND m_score >= 4 THEN '高价值忠诚'
                 WHEN r_score >= 4 AND f_score <= 2 THEN '高潜力新客'
                 WHEN r_score <= 2 AND f_score >= 4 THEN '流失风险高价值'
                 WHEN r_score <= 2 AND f_score <= 2 THEN '流失低价值'
                 ELSE '一般客户'
               END AS customer_segment
        FROM rfm_score;
    """
}

# 循环执行并导出
for name, sql in queries.items():
    print(f"正在导出 {name} ...")
    df = pd.read_sql(sql, engine)
    file_path = os.path.join(output_dir, f'{name}.csv')
    df.to_csv(file_path, index=False, encoding='utf-8-sig')  # utf-8-sig 防止中文乱码
    print(f"✅ {name}.csv 已保存，共 {len(df)} 行")
print("\n🎉 所有文件导出完成！")
# ===== Cell 2：导出 RFM 分层汇总 =====
sql = """
WITH rfm_base AS (
  SELECT customer_unique_id,
         DATEDIFF('2018-10-01', MAX(DATE(order_purchase_timestamp))) AS recency,
         COUNT(DISTINCT order_id) AS frequency,
         ROUND(SUM(order_value), 2) AS monetary
  FROM olist_clean GROUP BY customer_unique_id
),
rfm_score AS (
  SELECT *,
         NTILE(5) OVER (ORDER BY recency DESC) AS r_score,
         NTILE(5) OVER (ORDER BY frequency ASC) AS f_score,
         NTILE(5) OVER (ORDER BY monetary ASC) AS m_score
  FROM rfm_base
),
rfm_seg AS (
  SELECT *,
         CASE
           WHEN r_score >= 4 AND f_score >= 4 AND m_score >= 4 THEN '高价值忠诚'
           WHEN r_score >= 4 AND f_score <= 2 THEN '高潜力新客'
           WHEN r_score <= 2 AND f_score >= 4 THEN '流失风险高价值'
           WHEN r_score <= 2 AND f_score <= 2 THEN '流失低价值'
           ELSE '一般客户'
         END AS customer_segment
  FROM rfm_score
)
SELECT customer_segment,
       COUNT(*) AS customers,
       ROUND(AVG(recency), 0) AS avg_recency,
       ROUND(AVG(frequency), 1) AS avg_frequency,
       ROUND(AVG(monetary), 2) AS avg_monetary,
       ROUND(SUM(monetary), 2) AS total_gmv,
       ROUND(SUM(monetary) * 100.0 / SUM(SUM(monetary)) OVER(), 2) AS gmv_share
FROM rfm_seg GROUP BY customer_segment ORDER BY total_gmv DESC;
"""

df = pd.read_sql(sql, engine)
df.to_csv(os.path.join(output_dir, 'rfm_segment_summary.csv'), index=False, encoding='utf-8-sig')
print("✅ rfm_segment_summary.csv 已保存")
print(df)
