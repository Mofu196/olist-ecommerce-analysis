# ===== 02 合并大宽表 + 导入 MySQL =====

import pandas as pd
import os

clean_dir = r'C:\Users\15442\OneDrive\Desktop\Olist\data\clean'
raw_dir = r'C:\Users\15442\OneDrive\Desktop\Olist\data\raw'
# ===== Cell 1：合并大宽表 =====
orders = pd.read_csv(os.path.join(clean_dir, 'orders_clean.csv'))
items = pd.read_csv(os.path.join(clean_dir, 'items_clean.csv'))
customers = pd.read_csv(os.path.join(clean_dir, 'customers_clean.csv'))
payments = pd.read_csv(os.path.join(clean_dir, 'payments_clean.csv'))
reviews = pd.read_csv(os.path.join(clean_dir, 'reviews_clean.csv'))
products = pd.read_csv(os.path.join(clean_dir, 'products_clean.csv'))
sellers = pd.read_csv(os.path.join(raw_dir, 'olist_sellers_dataset.csv'))

# 时间字段转datetime（保存后重新读取会变回字符串）
date_cols = ['order_purchase_timestamp', 'order_delivered_customer_date', 'order_estimated_delivery_date']
for col in date_cols:
    orders[col] = pd.to_datetime(orders[col])

# 逐步合并
print("开始合并...")

df = orders.merge(items, on='order_id', how='left')
print(f"合并items后: {df.shape}")

df = df.merge(customers, on='customer_id', how='left')
print(f"合并customers后: {df.shape}")

df = df.merge(payments, on='order_id', how='left')
print(f"合并payments后: {df.shape}")

df = df.merge(reviews[['order_id', 'review_score', 'is_bad_review']], on='order_id', how='left')
print(f"合并reviews后: {df.shape}")

df = df.merge(products[['product_id', 'product_category_name_english']], on='product_id', how='left')
print(f"合并products后: {df.shape}")

df = df.merge(sellers[['seller_id', 'seller_state']], on='seller_id', how='left')
print(f"合并sellers后: {df.shape}")

# 客户订单次数（用customer_unique_id）
order_cnt = df.groupby('customer_unique_id')['order_id'].nunique().reset_index()
order_cnt.columns = ['customer_unique_id', 'order_count']
df = df.merge(order_cnt, on='customer_unique_id', how='left')
print(f"合并order_count后: {df.shape}")

# 新老客标记
first_order = df.groupby('customer_unique_id')['order_purchase_timestamp'].min().reset_index()
first_order.columns = ['customer_unique_id', 'first_order_date']
df = df.merge(first_order, on='customer_unique_id', how='left')
df['is_new_customer'] = (df['order_purchase_timestamp'] == df['first_order_date']).astype(int)

# 时间衍生字段
df['order_date'] = df['order_purchase_timestamp'].dt.date
df['order_month'] = df['order_purchase_timestamp'].dt.to_period('M').astype(str)
df['order_hour'] = df['order_purchase_timestamp'].dt.hour
df['order_dow'] = df['order_purchase_timestamp'].dt.dayofweek

# 验证
print("\n===== 大宽表验证 =====")
print(f"形状: {df.shape}")
print(f"总订单: {df['order_id'].nunique()}")
print(f"总客户: {df['customer_unique_id'].nunique()}")

# 订单级聚合
order_level_tmp = df.groupby('order_id').agg(
    order_gmv=('price', 'sum'),
    freight=('freight_value', 'max')
).reset_index()
order_level_tmp['order_gmv'] = order_level_tmp['order_gmv'] + order_level_tmp['freight']

print(f"订单级总GMV: {order_level_tmp['order_gmv'].sum():,.2f}")
print(f"明细级总GMV: {df['order_value'].sum():,.2f}")
print(f"订单级AOV: {order_level_tmp['order_gmv'].mean():,.2f}")
print(f"明细级平均价: {df['order_value'].mean():,.2f}")
print(f"日期范围: {df['order_purchase_timestamp'].min()} ~ {df['order_purchase_timestamp'].max()}")
print(f"\n关键字段空值:")
print(df[['order_value', 'review_score', 'product_category_name_english', 'payment_value']].isnull().sum())

# 保存
output_file = os.path.join(clean_dir, 'olist_clean.csv')
df.to_csv(output_file, index=False)
print(f"\n✅ olist_clean.csv 已保存")
print(f"文件大小: {os.path.getsize(output_file) / 1024 / 1024:.1f} MB")
# ===== Cell 2：导入 MySQL =====
from sqlalchemy import create_engine

df = pd.read_csv(os.path.join(clean_dir, 'olist_clean.csv'))

# 1. 处理所有日期字段，将无效日期转换为 NaT (Pandas 的空时间)
date_cols = ['order_purchase_timestamp', 'order_approved_at', 'order_delivered_carrier_date',
             'order_delivered_customer_date', 'order_estimated_delivery_date',
             'shipping_limit_date', 'first_order_date']

for col in date_cols:
    if col in df.columns:
        # errors='coerce' 会把无法解析的时间（如 0000-00-00）强制变成 NaT
        df[col] = pd.to_datetime(df[col], errors='coerce')

# 2. 检查还有没有零日期残留（NaT 在 Python 里是空值）
print("关键日期字段空值检查（NaT即为空）：")
for col in date_cols:
    if col in df.columns:
        print(f"{col}: {df[col].isna().sum()} 个")

# 3. 使用 to_sql 导入
engine = create_engine('mysql+pymysql://root:root@localhost:3306/olist?charset=utf8mb4')

df.to_sql('olist_clean', con=engine, if_exists='append', index=False, chunksize=5000)
print("✅ 导入成功！")
